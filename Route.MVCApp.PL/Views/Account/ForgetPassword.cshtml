@model ForgetPasswordViewModel
@{
    ViewData["Title"] = "ForgetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<form asp-action="SendResetPasswordUrl">
	<div class="user-details">
		<!-- Input for Email -->
		<div class="input-box">
			<span class="details">Email</span>
			<input asp-for="Email" placeholder="Enter Your Email" required />
			<span asp-validation-for="Email" class="text-danger"></span>
		</div>
		<!-- Submit button -->
		<div class="button">
			<input type="submit" style="padding: 10px;" value="Submit" />
		</div>
	</div>
</form>


@section ValidationScripts
{
	<partial name="_ValidationScriptsPartial" />
}
@model CreatedDepartmentDto
@{
	ViewData["Title"] = "Create";
}
<div class="row justify-content-center align-items-center">
	<h1>Create New Department</h1>
	<br />
	<br />

	<form asp-action="Create" class="col-8">

		<div asp-validation-summary="ModelOnly"></div>

		<div class="form-group mb-3">
			<label asp-for="Code" class="col-form-label"></label>
			<input asp-for="Code" class="form-control" />
			<span asp-validation-for="Code" class="text-danger"></span>
		</div>

		<div class="form-group mb-3">
			<label asp-for="Name" class="col-form-label"></label>
			<input asp-for="Name" class="form-control" />
			<span asp-validation-for="Name" class="text-danger"></span>
		</div>

		<div class="form-group mb-3">
			<label asp-for="Description" class="col-form-label"></label>
			<textarea asp-for="Description" class="form-control"></textarea>
			<span asp-validation-for="Description" class="text-danger"></span>
		</div>

		<div class="form-group mb-3">
			<label asp-for="CreationDate" class="col-form-label"></label>
			<input type="date" asp-for="CreationDate" class="form-control" />
		</div>

		<div class="mt-4">
			<input type="submit" value="Create" class="btn btn-primary" />
			<a asp-action="Index" class="btn btn-outline-dark">Back To List</a>
		</div>
	</form>
</div>
